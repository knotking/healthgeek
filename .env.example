# Copy to .env.local. Every value has a working default, so the app runs with an
# empty file — `AI_PROVIDER=mock` returns placeholder data and needs no account.

# --- Session signing ---------------------------------------------------------
# Optional. If unset, a random secret is generated once and stored at
# $HEALTHGEEK_DATA_DIR/auth-secret. Set it explicitly to control rotation, or if
# you run more than one instance against the same data.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Local data store --------------------------------------------------------
# Directory holding healthgeek.json. Defaults to ./.data
HEALTHGEEK_DATA_DIR=.data

# --- AI provider -------------------------------------------------------------
# mock      placeholder responses, no network calls (default)
# ollama    local models via Ollama
# openai    OpenAI, or anything speaking the OpenAI chat-completions protocol
# anthropic Anthropic Messages API
# gemini    Google Generative Language API
AI_PROVIDER=mock

# Model name. Defaults per provider: ollama=llama3.2, openai=gpt-4o-mini,
# anthropic=claude-opus-5, gemini=gemini-2.0-flash
AI_MODEL=

# API key for the chosen provider. Not needed for mock or ollama.
AI_API_KEY=

# Override the provider endpoint. Defaults: ollama=http://localhost:11434/v1,
# openai=https://api.openai.com/v1, anthropic=https://api.anthropic.com,
# gemini=https://generativelanguage.googleapis.com
# Point this at LM Studio, vLLM, llama.cpp, or a gateway to use those instead.
AI_BASE_URL=

# Response cap for the anthropic provider.
AI_MAX_TOKENS=8192
